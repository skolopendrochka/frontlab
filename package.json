{
  "name": "checkly-app",
  "version": "1.0.0",
  "description": "Checkly — чек-лист учебных задач, работа Екатерины Чичулиной",
  "productName": "Checkly",
  "author": "Екатерина Чичулина",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint --ext .ts,.vue src tests",
